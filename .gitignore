# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# MongoDB data & binaries (downloaded at runtime, not part of source)
/.mongodb/
/.logs/

# SQLite legacy db (if any)
/db/*.db
/db/*.db-journal

# Realtime mini-service runtime files
/mini-services/**/node_modules

# Downloaded binaries
/tmp/

# Build artifacts
*.tar

# IDE / OS files
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Keep scripts and source directories tracked
!scripts/
!mini-services/realtime-service/package.json
!mini-services/realtime-service/index.ts
!mini-services/realtime-service/start.sh

# User-uploaded files (not part of source)
/upload/
